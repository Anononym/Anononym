# Kopiere diese Datei nach .env und trage deine Werte ein.

# Name, mit dem Alfred dich anspricht
HERO_NAME=Bruce

# Passwort für die Website (Benutzername egal). PFLICHT, sobald die Seite online ist.
APP_PASSWORD=

# Stimme: https://elevenlabs.io -> Profil -> API Keys
ELEVENLABS_API_KEY=
# Voice-ID aus der ElevenLabs Voice Library (Standard: "George", britisch, ruhig)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Gehirn: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: wo Daten + Foto gespeichert werden (auf dem Server ein persistentes Volume)
# DATA_DIR=./data
